{
  "openapi": "3.1.0",
  "info": {
    "title": "Support Ticket Business API",
    "version": "v1"
  },
  "x-lenso-contract-id": "support-ticket-http",
  "x-lenso-contract-version": "v1",
  "x-lenso-module-id": "support-ticket",
  "paths": {
    "/tickets": {
      "get": {
        "operationId": "support-ticket/http/GET:/tickets",
        "summary": "List support tickets",
        "x-lenso-capability": "support_ticket.tickets.read",
        "x-lenso-idempotency": "idempotent",
        "x-lenso-connected-route": {
          "method": "GET",
          "path": "/modules/support-ticket/tickets"
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket page",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TicketPage" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/ProblemDetails" }
        }
      },
      "post": {
        "operationId": "support-ticket/http/POST:/tickets",
        "summary": "Create a support ticket",
        "x-lenso-capability": "support_ticket.tickets.write",
        "x-lenso-idempotency": "requires_key",
        "x-lenso-connected-route": {
          "method": "POST",
          "path": "/modules/support-ticket/tickets"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTicketInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created ticket",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TicketResult" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/ProblemDetails" }
        }
      }
    },
    "/tickets/{ticketId}": {
      "get": {
        "operationId": "support-ticket/http/GET:/tickets/{id}",
        "summary": "Get a support ticket",
        "x-lenso-capability": "support_ticket.tickets.read",
        "x-lenso-idempotency": "idempotent",
        "x-lenso-connected-route": {
          "method": "GET",
          "path": "/modules/support-ticket/tickets/{ticketId}"
        },
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Support ticket detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TicketResult" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/ProblemDetails" }
        }
      },
      "patch": {
        "operationId": "support-ticket/http/PATCH:/tickets/{id}",
        "summary": "Update a support ticket",
        "x-lenso-capability": "support_ticket.tickets.write",
        "x-lenso-idempotency": "requires_key",
        "x-lenso-connected-route": {
          "method": "PATCH",
          "path": "/modules/support-ticket/tickets/{ticketId}"
        },
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTicketInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated ticket",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TicketResult" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/ProblemDetails" }
        }
      }
    },
    "/tickets/{ticketId}/restricted": {
      "get": {
        "operationId": "support-ticket/http/GET:/tickets/{id}/restricted",
        "summary": "Get restricted support ticket detail",
        "x-lenso-capability": "support_ticket.tickets.read",
        "x-lenso-idempotency": "idempotent",
        "x-lenso-connected-route": {
          "method": "GET",
          "path": "/modules/support-ticket/tickets/{ticketId}"
        },
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Restricted support ticket detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TicketResult" }
              }
            }
          },
          "403": { "$ref": "#/components/responses/ProblemDetails" },
          "default": { "$ref": "#/components/responses/ProblemDetails" }
        }
      }
    },
    "/tickets/{ticketId}/close": {
      "post": {
        "operationId": "support-ticket/http/POST:/tickets/{id}/close",
        "summary": "Close a support ticket",
        "x-lenso-capability": "support_ticket.tickets.write",
        "x-lenso-idempotency": "requires_key",
        "x-lenso-connected-route": {
          "method": "PATCH",
          "path": "/modules/support-ticket/tickets/{ticketId}",
          "body": { "status": "closed" }
        },
        "parameters": [
          {
            "name": "ticketId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Closed ticket",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TicketResult" }
              }
            }
          },
          "default": { "$ref": "#/components/responses/ProblemDetails" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "ProblemDetails": {
        "description": "RFC 9457 Problem Details",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" }
          }
        }
      }
    },
    "schemas": {
      "ProblemErrorDetail": {
        "type": "object",
        "required": ["field", "reason"],
        "properties": {
          "field": { "type": ["string", "null"] },
          "reason": { "type": "string" }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "request_id",
          "correlation_id",
          "errors"
        ],
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer", "minimum": 100, "maximum": 599 },
          "detail": { "type": "string" },
          "code": { "type": "string" },
          "request_id": { "type": ["string", "null"] },
          "correlation_id": { "type": ["string", "null"] },
          "errors": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProblemErrorDetail" }
          },
          "next_actions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "Ticket": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "priority",
          "assignee",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["open", "pending", "escalated", "closed"]
          },
          "priority": { "type": "string", "enum": ["low", "normal", "high"] },
          "assignee": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "TicketPage": {
        "type": "object",
        "required": ["records", "next_cursor"],
        "properties": {
          "records": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Ticket" }
          },
          "next_cursor": { "type": ["string", "null"] }
        }
      },
      "TicketResult": {
        "type": "object",
        "required": ["ticket"],
        "properties": { "ticket": { "$ref": "#/components/schemas/Ticket" } }
      },
      "CreateTicketInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "priority": { "type": "string", "enum": ["low", "normal", "high"] },
          "assignee": { "type": "string" }
        }
      },
      "UpdateTicketInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["open", "pending", "escalated", "closed"]
          },
          "priority": { "type": "string", "enum": ["low", "normal", "high"] },
          "assignee": { "type": "string" }
        }
      }
    }
  }
}
