{
  "protocol": "lenso.system-sandbox.v1",
  "services": [
    {
      "serviceId": "support-sla-service",
      "workloads": [
        {
          "workloadId": "support-sla-service-api",
          "command": ["./target/debug/support-system-workload", "support-sla-service", "api"],
          "env": { "LENSO_SERVICE_STORE_ID": "support-sla-store" },
          "endpoint": "http://127.0.0.1:4211",
          "healthUrl": "http://127.0.0.1:4212/health/ready"
        },
        {
          "workloadId": "support-sla-service-worker",
          "command": ["./target/debug/support-system-workload", "support-sla-service", "worker"],
          "env": { "LENSO_SERVICE_STORE_ID": "support-sla-store" }
        },
        {
          "workloadId": "support-sla-service-migrate",
          "command": ["./target/debug/support-system-workload", "support-sla-service", "migrate"],
          "env": { "LENSO_SERVICE_STORE_ID": "support-sla-store" }
        }
      ]
    },
    {
      "serviceId": "support-ticket-service",
      "workloads": [
        {
          "workloadId": "support-ticket-service-api",
          "command": ["./target/debug/support-system-workload", "support-ticket-service", "api"],
          "scenarioCommand": ["./target/debug/support-system-workload", "scenario"],
          "env": { "LENSO_SERVICE_STORE_ID": "support-ticket-store" },
          "endpoint": "http://127.0.0.1:4210",
          "healthUrl": "http://127.0.0.1:4210/health/ready"
        },
        {
          "workloadId": "support-ticket-service-worker",
          "command": ["./target/debug/support-system-workload", "support-ticket-service", "worker"],
          "env": { "LENSO_SERVICE_STORE_ID": "support-ticket-store" }
        },
        {
          "workloadId": "support-ticket-service-migrate",
          "command": ["./target/debug/support-system-workload", "support-ticket-service", "migrate"],
          "env": { "LENSO_SERVICE_STORE_ID": "support-ticket-store" }
        }
      ]
    }
  ],
  "scenarios": [
    {
      "scenarioId": "deadline-timeout",
      "fault": {
        "kind": "timeout",
        "serviceId": "support-ticket-service",
        "workloadId": "support-ticket-service-api",
        "delayMs": 100
      },
      "callPolicy": {
        "deadlineMs": 50,
        "maxAttempts": 2,
        "idempotent": true
      }
    },
    {
      "scenarioId": "support-ticket-api-crash",
      "fault": {
        "kind": "workload_crash",
        "serviceId": "support-ticket-service",
        "workloadId": "support-ticket-service-api"
      },
      "callPolicy": {
        "deadlineMs": 50,
        "maxAttempts": 2,
        "idempotent": false
      }
    },
    {
      "scenarioId": "support-ticket-api-partial-unavailability",
      "fault": {
        "kind": "partial_unavailability",
        "serviceId": "support-ticket-service",
        "workloadId": "support-ticket-service-api"
      },
      "callPolicy": {
        "deadlineMs": 50,
        "maxAttempts": 2,
        "idempotent": false
      }
    }
  ]
}
