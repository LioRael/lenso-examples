{
  "protocol": "lenso.service.v2",
  "serviceId": "support-ticket-service",
  "version": "1.0.0",
  "workloads": [
    { "workloadId": "support-ticket-service-api", "serviceId": "support-ticket-service", "role": "api" },
    { "workloadId": "support-ticket-service-worker", "serviceId": "support-ticket-service", "role": "worker" },
    { "workloadId": "support-ticket-service-migrate", "serviceId": "support-ticket-service", "role": "migration" }
  ],
  "modules": ["support-ticket"],
  "stores": [
    { "storeId": "support-ticket-store", "serviceId": "support-ticket-service" }
  ],
  "serviceContracts": [
    {
      "contractId": "support-http",
      "moduleId": "support-ticket",
      "version": "v1",
      "tenancyMode": "none",
      "artifact": { "format": "openapi", "path": "contracts/support-http.v1.yaml" },
      "context": {
        "protocol": "lenso.context.v1",
        "required": ["service_principal", "deadline", "idempotency_key"]
      }
    }
  ],
  "eventContracts": [
    {
      "contractId": "ticket-opened",
      "moduleId": "support-ticket",
      "version": "v1",
      "tenancyMode": "required",
      "artifact": {
        "format": "json_schema",
        "path": "contracts/support.ticket-opened.v1.schema.json"
      },
      "context": {
        "protocol": "lenso.context.v1",
        "required": [
          "story",
          "trace",
          "service_principal",
          "delegated_actor",
          "tenant",
          "deadline",
          "idempotency_key",
          "causation",
          "region"
        ]
      }
    }
  ],
  "tenancyMode": "none",
  "operatingRegions": ["local"]
}
