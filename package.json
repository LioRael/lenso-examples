{
  "name": "@lenso/examples",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable examples for Lenso modules and API clients.",
  "type": "module",
  "scripts": {
    "acceptance:organization-invitation": "node scripts/organization-invitation-product-acceptance.mjs",
    "acceptance:notification-console-session": "node scripts/notification-console-session.mjs",
    "acceptance:organization-invitation:contract": "node --test scripts/organization-invitation-product-acceptance-contract.test.mjs",
    "acceptance:support-desk": "node scripts/support-desk-product-acceptance.mjs",
    "acceptance:support-desk:contract": "node --test scripts/support-desk-product-acceptance-contract.test.mjs",
    "acceptance:m1": "node scripts/m1-acceptance.mjs",
    "acceptance:m2": "node scripts/m2-acceptance.mjs",
    "acceptance:m2:production": "node scripts/m2-production-evidence.mjs",
    "acceptance:m3": "node scripts/m3-acceptance.mjs",
    "acceptance:m4": "node scripts/m4-acceptance.mjs",
    "acceptance:m5": "node scripts/m5-acceptance.mjs",
    "acceptance:m6": "node scripts/m6-acceptance.mjs",
    "acceptance:m6:environment": "node scripts/m6-environment-verification.mjs",
    "test:m6": "node --test scripts/m6-acceptance.test.mjs",
    "check": "pnpm smoke && pnpm --filter @lenso/example-support-ticket check && pnpm --filter @lenso/example-support-ticket-console test && pnpm --filter @lenso/example-support-ticket-console typecheck && pnpm host-api-smoke:contract && pnpm smoke:support-system:contract && pnpm acceptance:support-desk:contract && pnpm acceptance:organization-invitation:contract",
    "build:console-artifact:support-ticket": "node scripts/build-support-ticket-console-artifact.mjs",
    "integration:prepare": "node scripts/prepare-integration-set.mjs",
    "host-smoke": "pnpm --filter @lenso/example-hello-action host-smoke && pnpm --filter @lenso/example-support-ticket host-smoke && pnpm --filter @lenso/example-account-profile host-smoke",
    "host-smoke:account-profile": "pnpm --filter @lenso/example-account-profile host-smoke",
    "host-smoke:hello-action": "pnpm --filter @lenso/example-hello-action host-smoke",
    "host-smoke:support-ticket": "pnpm --filter @lenso/example-support-ticket host-smoke",
    "host-api-smoke": "pnpm host-api-smoke:support-ticket && pnpm host-api-smoke:account-profile",
    "host-api-smoke:account-profile": "node scripts/account-profile-host-api-smoke.ts",
    "host-api-smoke:contract": "node --test scripts/support-ticket-host-api-smoke-contract.test.ts",
    "smoke:support-system:contract": "node --test scripts/support-system-contract.test.mjs",
    "host-api-smoke:support-ticket": "node scripts/support-ticket-host-api-smoke.ts",
    "check:launchpad-fixtures": "node scripts/check-launchpad-fixtures.mjs",
    "check:app-composition-fixtures": "node scripts/check-app-composition-fixtures.mjs",
    "check:operator-fixtures": "node scripts/check-operator-fixtures.mjs",
    "rust-manifest": "cargo run --manifest-path examples/rust-manifest/Cargo.toml",
    "rust-service:check": "cargo run --manifest-path examples/rust-service/Cargo.toml -- --check",
    "service-deploy-export:support-ticket": "lenso service deploy export support-suite-provider --env staging --target kubernetes --output-dir examples/support-ticket/kubernetes/staging",
    "service-deploy-export:support-ticket:operator-prod": "lenso service deploy export support-suite-provider --env prod --target operator --hpa --pdb --network-policy --output-dir examples/support-ticket/kubernetes/operator/prod",
    "service-package:rust-service": "lenso service package --manifest http://127.0.0.1:4130/lenso/service/v1/manifest --output-dir dist/lenso-service",
    "service-package:support-ticket": "lenso service package --manifest http://127.0.0.1:4110/lenso/service/v1/manifest --output-dir dist/lenso-service",
    "smoke": "pnpm smoke:hello-action && pnpm smoke:support-ticket && pnpm smoke:account-profile",
    "smoke:account-profile": "pnpm --filter @lenso/example-account-profile smoke",
    "smoke:hello-action": "pnpm --filter @lenso/example-hello-action smoke",
    "smoke:support-ticket": "pnpm --filter @lenso/example-support-ticket smoke",
    "smoke:support-system": "node scripts/support-system-smoke.mjs",
    "start:account-profile": "pnpm --filter @lenso/example-account-profile start",
    "start:hello-action": "pnpm --filter @lenso/example-hello-action start",
    "start:rust-service": "cargo run --manifest-path examples/rust-service/Cargo.toml",
    "start:support-ticket": "pnpm --filter @lenso/example-support-ticket start"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.18",
    "@vitejs/plugin-react": "6.0.5",
    "vite": "8.2.0"
  },
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1"
}
